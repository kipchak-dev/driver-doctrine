{
    "name": "kipchak/driver-doctrine",
    "type": "driver",
    "description": "A Doctrine driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "Doctrine",
        "MySQL",
        "PGSQL",
        "ORM",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\Doctrine\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/doctrine"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "doctrine/orm": "^4",
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-filecache": "^1",
        "kipchak/driver-logger": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "suggest": {
        "kipchak/driver-memcached": "To cache entity manager metadata in Memcached ('store' => 'memcached'). Without it, use the file store."
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": "sample.config.php",
            "configName": "kipchak.doctrine.php",
            "initialise": "\\Kipchak\\Driver\\Doctrine\\Doctrine::initialise($container);",
            "after": [
                "kipchak/driver-config",
                "kipchak/driver-logger",
                "kipchak/driver-filecache",
                "kipchak/driver-memcached"
            ],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-doctrine"
        }
    }
}
