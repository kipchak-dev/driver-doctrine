{
    "name": "kipchak/driver-doctrine",
    "type": "driver",
    "description": "A Doctrine driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "Doctrine",
        "MySQL",
        "PGSQL",
        "ORM",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\Doctrine\\": "src/"
        }
    },
    "bin": [
        "bin/doctrine"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "doctrine/orm": "^4",
        "kipchak/core": "^2",
        "kipchak/driver-memcached": "^1",
        "kipchak/driver-filecache": "^1",
        "kipchak/driver-logger": "^1"
    }
}
